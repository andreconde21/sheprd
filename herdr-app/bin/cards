#!/usr/bin/env python3
"""cards: the sheprd card ledger on herdr-core (hc).

Agents report the cards (tickets, tasks) they work on; the Herdr app's
sheprd-panel and sheprd-cards mods, and Conductore, show them. Same commands
as `sheprd card`, so the sheprd-card skill carries over with one word changed.

Storage: one hc document per machine, `sheprd-cards` (see ../CONTRACT.md),
read and written through `hc connect` with version checks, so two agents
writing at once never lose an update.

  cards update SHE-12 --title "Stripe checkout" --status dev --summary "..."
  cards ask SHE-12 "Which provider?" --option Stripe --option Multibanco --recommend 1
  cards decide SHE-12 "Use Checkout, not Elements"
  cards answered SHE-12 --question 1 [--answer "Stripe"]    the user answered in the chat: close it
  cards replied SHE-12:1 [SHE-13:2 ...]    (hook) open questions the user replied to in the chat
  cards done SHE-12 --summary "Merged as #41; live on dev"
  cards answers [--peek]     answers the user sent you (marks them read)
  cards list                 your cards
  cards evidence SHE-12 --image shot.png [--label L] | --test "suite: 37/0" | --link URL [--label L] | --clear
  cards evidence-image <ID> <N>    an image's bytes as base64 (for the app)

For the app and Conductore (not agents):
  cards json                         the whole document
  cards stage <terminal> <ID> <N> <answer>
  cards dismiss <terminal> <ID> [--question N]
  cards send <terminal>              deliver staged answers with `hc send`
  cards view                         the sidebar layout (sheprd-view)
  cards view-set '<json>'            merge top-level keys into it
"""

import argparse
import datetime as dt
import json
import os
import base64
import hashlib
import re
import shutil
import stat
import struct
import subprocess
import sys
import tempfile
import time
from urllib.parse import urlparse

DOC = os.environ.get("CARDS_DOC", "sheprd-cards")
VIEW_DOC = os.environ.get("CARDS_VIEW_DOC", "sheprd-view")
VERSION = 1
KEEP_DONE_DAYS = 14
# Open cards a previous program in the same terminal left behind are kept (a new session
# usually continues the same work) but expire sooner than the 30 days of a live card.
KEEP_PREVIOUS_DAYS = 7
MAX_DECISIONS = 50
MAX_INBOX = 50


def now():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()


def fail(message, code=1):
    print(f"cards: {message}", file=sys.stderr)
    sys.exit(code)


def hc_binary():
    found = shutil.which("hc") or os.path.expanduser("~/.local/bin/hc")
    if not os.path.exists(found):
        fail("hc (herdr-core) is not installed on this machine")
    return found


class Core:
    """One `hc connect` session: JSON-RPC lines over stdin/stdout."""

    def __init__(self):
        self.proc = subprocess.Popen(
            [hc_binary(), "connect"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        self.next_id = 0

    def call(self, method, params):
        self.next_id += 1
        request = {"jsonrpc": "2.0", "id": self.next_id, "method": method, "params": params}
        self.proc.stdin.write(json.dumps(request) + "\n")
        self.proc.stdin.flush()
        while True:
            line = self.proc.stdout.readline()
            if not line:
                err = self.proc.stderr.read().strip()
                fail(f"hc connect closed: {err or 'no reply'}")
            reply = json.loads(line)
            if reply.get("id") != self.next_id:
                continue  # a notification
            if "error" in reply:
                raise RpcError(reply["error"])
            return reply["result"]

    def close(self):
        try:
            self.proc.stdin.close()
            self.proc.wait(timeout=5)
        except Exception:
            self.proc.kill()


class RpcError(Exception):
    def __init__(self, error):
        super().__init__(error.get("message", str(error)))
        self.error = error


def empty_doc():
    return {"v": VERSION, "cards": {}, "inbox": {}}


def load(core):
    result = core.call("doc.get", {"name": DOC})
    value = result.get("value") or empty_doc()
    value.setdefault("cards", {})
    value.setdefault("inbox", {})
    return value, result.get("version", 0)


def change(mutate):
    """Read, mutate, write with the version; retry when someone wrote in between."""
    core = Core()
    try:
        for attempt in range(8):
            doc, version = load(core)
            out = mutate(doc)
            prune(doc)
            try:
                core.call("doc.set", {"name": DOC, "value": doc, "version": version})
                return out
            except RpcError as err:
                if "exceeds" in str(err):
                    # Past herdr-core's 1 MiB cap every write fails; drop history so this one lands.
                    prune(doc, hard=True)
                    try:
                        core.call("doc.set", {"name": DOC, "value": doc, "version": version})
                        return out
                    except RpcError as again:
                        err = again
                if (err.error.get("data") or {}).get("kind") != "conflict":
                    fail(f"hc refused the write: {err}")
                time.sleep(0.05 * (attempt + 1))
        fail("the cards document kept changing; try again")
    finally:
        core.close()


def read_doc():
    core = Core()
    try:
        return load(core)[0]
    finally:
        core.close()


def age_days(stamp):
    if not stamp:
        return 0
    return (dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(stamp)).total_seconds() / 86400


def prune(doc, hard=False):
    """Keeps the document well under herdr-core's 1 MiB: old cards, answered
    questions and read answers go. `hard` (after a write hit the cap) keeps
    only what is still in play."""
    done_days, dismissed_days, stale_days = (0, 0, 7) if hard else (KEEP_DONE_DAYS, 7, 30)
    resolved_kept, decisions_kept, read_kept = (5, 20, 0) if hard else (20, MAX_DECISIONS, 5)
    for key in list(doc["cards"]):
        card = doc["cards"][key]
        if card.get("done") and age_days(card.get("done_at")) >= done_days:
            del doc["cards"][key]
        elif card.get("dismissed") and age_days(card.get("updated_at")) >= dismissed_days:
            del doc["cards"][key]
        elif not card.get("done") and age_days(card.get("updated_at")) >= stale_days:
            del doc["cards"][key]
        else:
            questions = card.get("questions", [])
            resolved = [q for q in questions if not live(q)]
            keep = {id(q) for q in resolved[-resolved_kept:]} if resolved_kept else set()
            card["questions"] = [q for q in questions if live(q) or id(q) in keep]
            card["decisions"] = card.get("decisions", [])[-decisions_kept:]
    for terminal in list(doc["inbox"]):
        entries = [a for a in doc["inbox"][terminal] if age_days(a.get("at")) < KEEP_DONE_DAYS]
        unread = [a for a in entries if not a.get("read")]
        read = [a for a in entries if a.get("read")][-read_kept:] if read_kept else []
        entries = sorted(read + unread, key=lambda a: a["at"])[-MAX_INBOX:]
        if entries:
            doc["inbox"][terminal] = entries
        else:
            del doc["inbox"][terminal]
    # Shown documents (`cards doc`): only the latest per terminal, for a week.
    for terminal in list(doc.get("docs") or {}):
        if age_days(doc["docs"][terminal].get("at")) >= (1 if hard else 7):
            del doc["docs"][terminal]


def live(question):
    return question.get("state") in ("open", "staged", "sending")


# A terminal id (t7) can come back for a new program after a core restart; its
# start time tells the two apart. A new program keeps the open cards of the old
# one (they are adopted), drops the finished ones, and lets stale ones expire.
_born = {}


def born_of(terminal):
    if terminal not in _born:
        try:
            got = subprocess.run([hc_binary(), "get", terminal, "--json"], capture_output=True, text=True, timeout=10)
            _born[terminal] = json.loads(got.stdout).get("created_ms") if got.returncode == 0 else None
        except (subprocess.TimeoutExpired, json.JSONDecodeError, AttributeError):
            _born[terminal] = None
    return _born[terminal]


def forget_previous(doc, terminal, born):
    """A new program started in this terminal. Cards a previous program left open stay and
    become this program's (so a restarted session still sees its work); finished or dismissed
    ones go, and open ones not touched for KEEP_PREVIOUS_DAYS expire. The previous program's
    answers go too, read or not: after a restart this may be a different task, and `cards
    answers` must not hand it answers to someone else's questions (each answer is still on its
    question)."""
    if born is None:
        return
    for key in list(doc["cards"]):
        card = doc["cards"][key]
        if card["terminal"] != terminal or card.get("born") in (None, born):
            continue
        if card.get("done") or card.get("dismissed") or age_days(card.get("updated_at")) >= KEEP_PREVIOUS_DAYS:
            del doc["cards"][key]
        else:
            card["born"] = born
    if terminal in doc["inbox"]:
        doc["inbox"][terminal] = [a for a in doc["inbox"][terminal] if a.get("born") in (None, born)]


def my_terminal(args):
    terminal = getattr(args, "terminal", None) or os.environ.get("HC_TERMINAL_ID")
    if not terminal:
        fail("not inside a herdr-core terminal (no HC_TERMINAL_ID); pass --terminal")
    return terminal


def card_key(terminal, card_id):
    return f"{terminal}/{card_id}"


def get_card(doc, terminal, card_id, create=False):
    """`create` is the agents' path: it also drops what an earlier program in this terminal left."""
    if create:
        forget_previous(doc, terminal, born_of(terminal))
    key = card_key(terminal, card_id)
    card = doc["cards"].get(key)
    if card is None:
        if not create:
            fail(f"no card {card_id} for {terminal}")
        card = {
            "born": born_of(terminal),
            "id": card_id,
            "terminal": terminal,
            "title": None,
            "status": None,
            "summary": None,
            "link": None,
            "questions": [],
            "decisions": [],
            "done": False,
            "done_at": None,
            "dismissed": False,
            "writeback": None,
            "created_at": now(),
            "updated_at": now(),
        }
        doc["cards"][key] = card
    return card


def touch(card):
    card["updated_at"] = now()
    card["dismissed"] = False


def clip(text, limit):
    text = " ".join((text or "").split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


# ---- agent commands -------------------------------------------------------


def cmd_update(args):
    terminal = my_terminal(args)

    def mutate(doc):
        card = get_card(doc, terminal, args.id, create=True)
        inferred = getattr(args, "inferred", False)
        # An explicit write always wins: an inferred one (from a hook) only fills what no
        # explicit write has set, and never reopens a done card or un-dismisses one.
        explicit = card.setdefault("explicit", [])
        for field, limit in (("title", 120), ("status", 30), ("summary", 600), ("link", 500)):
            value = getattr(args, field)
            if value is None:
                continue
            if inferred:
                if field not in explicit and not card["done"]:
                    card[field] = clip(value, limit)
            else:
                card[field] = clip(value, limit)
                if field not in explicit:
                    explicit.append(field)
        if not inferred and card["done"] and args.status and args.status not in ("done",):
            card["done"] = False
        questions = getattr(args, "inferred_question", None) or []
        if inferred and (questions or getattr(args, "clear_questions", False)):
            # The hook sends the questions the agent's last message left open, all of them
            # each time: the earlier inferred ones are replaced (answered ones stay).
            card["questions"] = [q for q in card["questions"] if not (q.get("inferred") and q["state"] == "open")]
            number = max((q["n"] for q in card["questions"]), default=0)
            for text in questions:
                number += 1
                card["questions"].append({"n": number, "text": clip(text, 300), "options": [], "recommend": None,
                                          "state": "open", "answer": None, "asked_at": now(), "inferred": True})
        if inferred:
            card["updated_at"] = now()
        else:
            touch(card)

    change(mutate)
    print(f"{args.id} updated")


def cmd_ask(args):
    terminal = my_terminal(args)
    options = [clip(o, 80) for o in args.option or []]
    if args.recommend is not None and not 1 <= args.recommend <= len(options):
        fail("--recommend must name one of the options, from 1")

    def mutate(doc):
        card = get_card(doc, terminal, args.id, create=True)
        number = 1 + max((q["n"] for q in card["questions"]), default=0)
        card["questions"].append(
            {
                "n": number,
                "text": clip(args.question, 300),
                "options": options,
                "recommend": args.recommend,
                "state": "open",
                "answer": None,
                "asked_at": now(),
            }
        )
        touch(card)
        return number

    number = change(mutate)
    print(f"{args.id} Q{number} asked; the answer arrives typed into your terminal")


def cmd_answered(args):
    """The agent closes questions the user answered in the conversation instead of in the panel."""
    terminal = my_terminal(args)
    if args.question is None and not args.all:
        fail("name the question (--question N) or use --all")

    def mutate(doc):
        card = get_card(doc, terminal, args.id)
        closed = []
        for q in card["questions"]:
            if not (live(q) or q["state"] == "replied") or not (args.all or q["n"] == args.question):
                continue
            if q["state"] == "sending" and not stale_claim(q):
                fail(f"{args.id} Q{q['n']} is being sent")
            q["state"] = "answered"
            q["answered_at"] = now()
            if args.answer is not None:
                q["answer"] = clip(args.answer, 300)
            closed.append(q["n"])
        if not closed:
            fail(f"{args.id} has no open question" + ("" if args.all else f" Q{args.question}"))
        touch(card)
        return closed

    closed = change(mutate)
    print(f"{args.id} " + ", ".join(f"Q{n}" for n in closed) + " answered")


def cmd_replied(args):
    """A hook marks open questions the user replied to in the chat without the agent closing
    them: `replied` (not live, so no longer counted as unanswered). Only `open` ones change:
    staged, sending, answered and dismissed questions are left alone, and so is a
    question that no longer exists. `cards answered` or an app answer still wins later."""
    terminal = my_terminal(args)

    def mutate(doc):
        marked = []
        for item in args.items:
            card_id, _, number = item.rpartition(":")
            card = doc["cards"].get(card_key(terminal, card_id))
            if not card or not number.isdigit():
                continue
            for q in card["questions"]:
                if q["n"] == int(number) and q["state"] == "open":
                    q["state"] = "replied"
                    q["replied_at"] = now()
                    marked.append(item)
        return marked

    marked = change(mutate)
    print("replied " + (", ".join(marked) if marked else "none"))


def cmd_reopen(args):
    """An app puts a `replied` question back to `open`."""
    def mutate(doc):
        card = get_card(doc, args.terminal, args.id)
        for q in card["questions"]:
            if q["n"] == args.question:
                if q["state"] != "replied":
                    fail(f"{args.id} Q{args.question} is not marked as replied")
                q["state"] = "open"
                q.pop("replied_at", None)
                card["updated_at"] = now()
                return
        fail(f"{args.id} has no Q{args.question}")

    change(mutate)
    print("reopened")


def cmd_decide(args):
    terminal = my_terminal(args)

    def mutate(doc):
        card = get_card(doc, terminal, args.id, create=True)
        card["decisions"].append({"text": clip(args.decision, 200), "at": now()})
        touch(card)

    change(mutate)
    print(f"{args.id} decision recorded")


def cmd_doc(args):
    """Ask the app to show a document beside this agent (sheprd-doc in the Herdr app)."""
    terminal = my_terminal(args)
    path = os.path.abspath(os.path.expanduser(args.path))
    if not os.path.isfile(path):
        fail(f"no such file: {path}")
    line = args.line if args.line and args.line > 0 else None

    def mutate(doc):
        docs = doc.setdefault("docs", {})
        seq = (docs.get(terminal) or {}).get("seq", 0) + 1
        docs[terminal] = {"path": path, "line": line, "at": now(), "seq": seq}

    change(mutate)
    print(f"showing {path} beside {terminal} (the app opens it within a few seconds)")


def cmd_done(args):
    terminal = my_terminal(args)

    def mutate(doc):
        card = get_card(doc, terminal, args.id, create=True)
        if args.summary is not None:
            card["summary"] = clip(args.summary, 600)
        card["done"] = True
        card["status"] = "done"
        card["done_at"] = now()
        touch(card)
        return json.loads(json.dumps(card))

    card = change(mutate)
    outcome = writeback(card)
    if outcome is not None:

        def record(doc):
            stored = doc["cards"].get(card_key(terminal, args.id))
            if stored:
                stored["writeback"] = outcome

        change(record)
    note = f" ({'✓' if outcome['ok'] else '!'} {outcome['message']})" if outcome else ""
    print(f"{args.id} done{note}")


def cmd_answers(args):
    terminal = my_terminal(args)

    def mutate(doc):
        forget_previous(doc, terminal, born_of(terminal))
        unread = [a for a in doc["inbox"].get(terminal, []) if not a.get("read")]
        if not args.peek:
            for a in unread:
                a["read"] = True
        return unread

    unread = mutate(read_doc()) if args.peek else change(mutate)
    if not unread:
        print("no new answers")
    for a in unread:
        print(a["line"])


def cmd_list(args):
    terminal = my_terminal(args)
    doc = read_doc()
    mine = [c for c in doc["cards"].values() if c["terminal"] == terminal]
    if args.json:
        print(json.dumps(mine, indent=2))
        return
    if not mine:
        print("no cards")
    for c in sorted(mine, key=lambda c: c["updated_at"], reverse=True):
        print(f"{c['id']}  [{c.get('status') or '-'}]  {c.get('title') or ''}")
        if c.get("summary"):
            print(f"    {c['summary']}")
        for q in c["questions"]:
            if live(q) or q["state"] == "replied":
                print(f"    Q{q['n']} ({q['state']}): {q['text']}")


# ---- evidence ---------------------------------------------------------------
# What an agent verified, shown on its card: screenshots (copied into a private folder: the
# document has a 1 MiB cap), test runs ("suite: passed/failed") and links.

EVIDENCE_KEEP = 12
IMAGE_MAX = 2 * 1024 * 1024
IMAGE_PIXELS_MAX = 16_000_000  # a small file can still decode to gigabytes: budget by area, not side
IMAGE_SIDE_MAX = 16383  # the largest side webp can even express
GIF_FRAMES_MAX = 500
GIF_TOTAL_FACTOR = 4  # all frames together may hold this many budgets of pixels
FILE_NAME = re.compile(r"^[A-Za-z0-9#_][A-Za-z0-9#._-]{0,99}$")  # no leading dot: not ".", ".." or a hidden temp
IMAGE_TYPES = ((b"\x89PNG\r\n\x1a\n", "png", "image/png"), (b"\xff\xd8\xff", "jpg", "image/jpeg"),
               (b"GIF87a", "gif", "image/gif"), (b"GIF89a", "gif", "image/gif"))


def evidence_dir():
    base = os.environ.get("SHEPRD_EVIDENCE_DIR")
    if base:
        return base
    return os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "sheprd", "evidence")


def read_regular(path, limit):
    """A regular file's bytes, at most `limit`. A FIFO, device or directory (or a link to one) is
    refused without blocking (O_NONBLOCK, then fstat), an oversized file is refused unread."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOCTTY", 0))
    except OSError as err:
        fail(f"cannot read {os.path.basename(path)}: {err.strerror}")
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            fail(f"{os.path.basename(path)} is not a regular file")
        if info.st_size > limit:
            fail(f"{os.path.basename(path)} is larger than {limit // 1024 // 1024} MB")
        data = b""
        while len(data) <= limit:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
        if len(data) > limit:
            fail(f"{os.path.basename(path)} is larger than {limit // 1024 // 1024} MB")
        return data
    except OSError as err:
        fail(f"cannot read {os.path.basename(path)}: {err.strerror}")
    finally:
        os.close(fd)


def image_type(data):
    """(extension, mime) from the first bytes: png, jpeg, gif or webp; None for anything else."""
    for magic, ext, mime in IMAGE_TYPES:
        if data.startswith(magic):
            return ext, mime
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "webp", "image/webp"
    return None


def image_size(data):
    """(width, height) from the image header (png, gif, jpeg, webp), or None when it cannot be read."""
    try:
        if data.startswith(b"\x89PNG") and data[12:16] == b"IHDR":
            return struct.unpack(">II", data[16:24])
        if data[:3] == b"GIF":
            return struct.unpack("<HH", data[6:10])
        if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
            kind = data[12:16]
            if kind == b"VP8X":
                return (1 + int.from_bytes(data[24:27], "little"), 1 + int.from_bytes(data[27:30], "little"))
            if kind == b"VP8L" and data[20] == 0x2F:
                bits = int.from_bytes(data[21:25], "little")
                return ((bits & 0x3FFF) + 1, ((bits >> 14) & 0x3FFF) + 1)
            if kind == b"VP8 " and data[23:26] == b"\x9d\x01\x2a":
                return (struct.unpack("<H", data[26:28])[0] & 0x3FFF, struct.unpack("<H", data[28:30])[0] & 0x3FFF)
            return None
        if data[:3] == b"\xff\xd8\xff":
            i = 2
            while i + 9 < len(data):
                if data[i] != 0xFF:
                    i += 1
                    continue
                marker = data[i + 1]
                if marker == 0xFF:
                    i += 1
                elif marker in (0x01, 0xD8) or 0xD0 <= marker <= 0xD7:
                    i += 2
                elif 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
                    height, width = struct.unpack(">HH", data[i + 5:i + 9])
                    return (width, height)
                else:
                    i += 2 + struct.unpack(">H", data[i + 2:i + 4])[0]
    except (struct.error, IndexError):
        pass
    return None


def gif_frames(data):
    """The (width, height) of every frame of a GIF, read from its image descriptors, or None when
    the block structure cannot be followed."""
    try:
        i = 13
        if data[10] & 0x80:
            i += 3 * (2 << (data[10] & 7))
        frames = []
        while i < len(data):
            block = data[i]
            if block == 0x3B:
                return frames
            if block == 0x2C:
                _, _, width, height = struct.unpack("<HHHH", data[i + 1:i + 9])
                frames.append((width, height))
                if len(frames) > GIF_FRAMES_MAX:
                    return None
                flags = data[i + 9]
                i += 10 + (3 * (2 << (flags & 7)) if flags & 0x80 else 0) + 1  # + LZW minimum code size
            elif block == 0x21:
                i += 2
            else:
                return None
            while data[i]:  # data sub-blocks
                i += 1 + data[i]
            i += 1
    except (struct.error, IndexError):
        return None
    return None


def check_image(data):
    """(extension, mime) of an acceptable image, else fails: type by magic bytes, size from the header."""
    kind = image_type(data)
    if not kind:
        fail("only png, jpeg, gif and webp images are accepted")
    size = image_size(data)
    limit = f"the image must be at most {IMAGE_PIXELS_MAX // 1_000_000} megapixels (and its size readable)"
    if not size or not 0 < size[0] <= IMAGE_SIDE_MAX or not 0 < size[1] <= IMAGE_SIDE_MAX or size[0] * size[1] > IMAGE_PIXELS_MAX:
        fail(limit)
    if kind[0] == "gif":
        frames = gif_frames(data)
        if (frames is None or any(not 0 < w * h <= IMAGE_PIXELS_MAX for w, h in frames)
                or sum(w * h for w, h in frames) > GIF_TOTAL_FACTOR * IMAGE_PIXELS_MAX):
            fail(limit + ", and so must every frame of a gif")
    return kind


def private_dir(folder):
    """The evidence folder: created 0700, or an existing one of ours tightened to 0700. A symlink,
    a non-directory or someone else's folder is refused."""
    os.makedirs(folder, mode=0o700, exist_ok=True)
    info = os.lstat(folder)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        fail("the evidence folder is not a directory of yours")
    if info.st_mode & 0o077:
        os.chmod(folder, 0o700)


def cmd_evidence(args):
    terminal = my_terminal(args)
    given = [x for x in (args.image, args.test, args.link) if x is not None]
    if len(given) + bool(args.clear) != 1:
        fail("give exactly one of --image, --test, --link or --clear")
    label = clip(args.label, 40) if args.label else ""
    item = None
    if args.image is not None:
        data = read_regular(args.image, IMAGE_MAX)
        kind = check_image(data)
        name = f"{terminal}-{args.id}-{hashlib.sha256(data).hexdigest()[:16]}.{kind[0]}"
        if not FILE_NAME.match(name):
            fail("this card id cannot name a file")
        folder = evidence_dir()
        private_dir(folder)
        tmp = os.path.join(folder, f".{name}.{os.getpid()}.tmp")
        try:
            os.unlink(tmp)  # a stale one of ours, or a planted link: never written through
        except OSError:
            pass
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        os.replace(tmp, os.path.join(folder, name))
        item = {"kind": "image", "file": name, "mime": kind[1], "label": label}
    elif args.test is not None:
        text = clip(args.test, 120)
        if not text:
            fail("--test needs a text like \"suite: 37/0\" (passed/failed)")
        match = re.search(r"(\d+)\s*/\s*(\d+)\s*$", text)
        item = {"kind": "test", "text": text, "label": label,
                "passed": int(match.group(1)) if match else None, "failed": int(match.group(2)) if match else None}
    elif args.link is not None:
        url = args.link.strip()
        parsed = urlparse(url)
        if parsed.scheme not in ("http", "https") or not parsed.netloc or len(url) > 500 or any(c.isspace() or not c.isprintable() for c in url):
            fail("--link needs one http(s) URL")
        item = {"kind": "link", "url": url, "label": label or parsed.netloc[:40]}

    def mutate(doc):
        card = get_card(doc, terminal, args.id, create=True)
        evidence = card.setdefault("evidence", [])
        old = list(evidence)
        if item is None:
            evidence.clear()
        else:
            evidence.append({**item, "at": now()})
            del evidence[:-EVIDENCE_KEEP]
        card["updated_at"] = now()
        kept = {e.get("file") for e in evidence}
        return [e["file"] for e in old if e.get("file") and e["file"] not in kept]

    for name in change(mutate):
        if FILE_NAME.match(name):
            try:
                os.unlink(os.path.join(evidence_dir(), name))
            except OSError:
                pass
    print(f"{args.id} evidence " + ("cleared" if item is None else f"added ({item['kind']})"))


def cmd_evidence_image(args):
    terminal = my_terminal(args)
    card = read_doc()["cards"].get(card_key(terminal, args.id))
    evidence = (card or {}).get("evidence") or []
    if not card or not 1 <= args.n <= len(evidence) or evidence[args.n - 1].get("kind") != "image":
        fail(f"{args.id} has no image evidence #{args.n}")
    name = str(evidence[args.n - 1].get("file") or "")
    if not FILE_NAME.match(name):
        fail("bad evidence file name")
    data = read_regular(os.path.join(evidence_dir(), name), IMAGE_MAX)
    check_image(data)
    print(base64.b64encode(data).decode())


# ---- app commands ---------------------------------------------------------


def cmd_json(_args):
    print(json.dumps(read_doc()))


def cmd_stage(args):
    def mutate(doc):
        card = get_card(doc, args.terminal, args.id)
        for q in card["questions"]:
            if q["n"] == args.n:
                if q["state"] == "sent":
                    fail(f"{args.id} Q{args.n} was already sent")
                if q["state"] == "sending" and not stale_claim(q):
                    fail(f"{args.id} Q{args.n} is being sent")
                q["answer"] = clip(args.answer, 300)
                q["state"] = "staged"
                card["updated_at"] = now()
                return
        fail(f"{args.id} has no Q{args.n}")

    change(mutate)
    print(f"{args.id} Q{args.n} staged")


def cmd_dismiss(args):
    def mutate(doc):
        card = get_card(doc, args.terminal, args.id)
        if args.question is None:
            card["dismissed"] = True
            for q in card["questions"]:
                if q["state"] in ("open", "staged"):
                    q["state"] = "dismissed"
        else:
            for q in card["questions"]:
                if q["n"] == args.question:
                    q["state"] = "dismissed"
        card["updated_at"] = now()

    change(mutate)
    print("dismissed")


def answer_text(answer):
    return answer if re.fullmatch(r"[\w .,:/#@+-]{1,80}", answer) else json.dumps(answer, ensure_ascii=False)


# A claim older than this belongs to a send that died midway; its answers can be staged again.
CLAIM_TIMEOUT_S = 120


def stale_claim(q):
    at = q.get("claimed_at")
    return not at or (dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(at)).total_seconds() > CLAIM_TIMEOUT_S


def cmd_send(args):
    """Claims the staged answers (staged → sending), types exactly those into
    the agent, then marks exactly those sent. An answer staged or changed
    during the send stays staged for the next one; a second Send finds nothing."""
    token = f"{os.getpid()}-{time.time()}"

    def claim(doc):
        parts, claimed = [], []
        for key, card in sorted(doc["cards"].items(), key=lambda kv: kv[1]["id"]):
            if card["terminal"] != args.terminal:
                continue
            staged = [q for q in card["questions"] if q["state"] == "staged" or (q["state"] == "sending" and stale_claim(q))]
            if not staged:
                continue
            bits = []
            for i, q in enumerate(staged):
                label = f"Q{q['n']} ({clip(q['text'], 60)})" if i == 0 else f"Q{q['n']}"
                bits.append(f"{label} → {answer_text(q['answer'])}")
                q.update(state="sending", claim=token, claimed_at=now())
                claimed.append((key, q["n"], q["answer"]))
            parts.append(f"{card['id']} " + " · ".join(bits))
        return " | ".join(parts), claimed

    line, claimed = change(claim)
    if not claimed:
        fail("nothing staged for that terminal")
    # Under the claim timeout, so a slow send can't be claimed again and typed twice.
    try:
        sent = subprocess.run([hc_binary(), "send", "--", args.terminal, line], capture_output=True, text=True,
                              timeout=CLAIM_TIMEOUT_S - 20)
    except subprocess.TimeoutExpired:
        sent = subprocess.CompletedProcess([], 1, "", "the agent never paused long enough to type into it")
    ok = sent.returncode == 0
    born = born_of(args.terminal)

    def settle(doc):
        for key, n, answer in claimed:
            card = doc["cards"].get(key)
            for q in card["questions"] if card else []:
                if q["n"] == n and q.get("claim") == token and q["state"] == "sending":
                    q["state"] = "sent" if ok else "staged"
                    q["answer"] = answer
                    q.pop("claim", None)
                    q.pop("claimed_at", None)
            if card:
                card["updated_at"] = now()
        if ok:
            doc["inbox"].setdefault(args.terminal, []).append({"line": line, "at": now(), "read": False, "born": born})

    change(settle)
    if not ok:
        fail(f"hc send refused: {(sent.stderr or sent.stdout).strip()}")
    print(line)


# ---- sidebar layout (sheprd-view) ------------------------------------------

VIEW_KEYS = ("projects", "hidden", "filter", "active_only", "other_collapsed", "marks", "density", "machine_tags", "other_muted")


def sidebar_import():
    """sheprd's sidebar.toml as a sheprd-view document, or None."""
    path = os.path.expanduser("~/.config/herdr/sidebar.toml")
    if not os.path.exists(path):
        return None
    import tomllib

    with open(path, "rb") as f:
        old = tomllib.load(f)
    fields = ("name", "short", "pinned", "collapsed", "members", "match", "note")
    projects = [{k: g.get(k) for k in fields if g.get(k) is not None} for g in old.get("group", [])]
    return {
        "v": VERSION,
        "projects": projects,
        "hidden": old.get("hidden", []),
        "filter": "all",
        "active_only": bool(old.get("active_only", False)),
        "other_collapsed": bool(old.get("other_collapsed", False)),
        "density": "detailed",
        "machine_tags": {},
        # sheprd's marks name its own pane ids, which mean nothing to herdr-core.
        "marks": {"unread": [], "kept": [], "dismissed": [], "marked": []},
    }


def cmd_view(_args):
    core = Core()
    try:
        result = core.call("doc.get", {"name": VIEW_DOC})
        value = result.get("value")
        if value is None:
            value = sidebar_import() or {"v": VERSION, "projects": [], "hidden": [], "filter": "all",
                                         "active_only": False, "other_collapsed": False,
                                         "density": "detailed", "machine_tags": {},
                                         "marks": {"unread": [], "kept": [], "dismissed": [], "marked": []}}
            try:
                core.call("doc.set", {"name": VIEW_DOC, "value": value, "version": result.get("version", 0)})
            except RpcError:
                value = core.call("doc.get", {"name": VIEW_DOC}).get("value") or value
        print(json.dumps(value))
    finally:
        core.close()


def cmd_view_set(args):
    try:
        patch = json.loads(args.patch)
    except json.JSONDecodeError as err:
        fail(f"not JSON: {err}")
    if not isinstance(patch, dict) or set(patch) - set(VIEW_KEYS):
        fail(f"view-set takes an object with keys from {', '.join(VIEW_KEYS)}")
    core = Core()
    try:
        for attempt in range(8):
            result = core.call("doc.get", {"name": VIEW_DOC})
            value = result.get("value") or {"v": VERSION}
            value.update(patch)
            try:
                core.call("doc.set", {"name": VIEW_DOC, "value": value, "version": result.get("version", 0)})
                print("ok")
                return
            except RpcError as err:
                if (err.error.get("data") or {}).get("kind") != "conflict":
                    fail(f"hc refused the write: {err}")
                time.sleep(0.05 * (attempt + 1))
        fail("the view document kept changing; try again")
    finally:
        core.close()


# ---- write-back (same [ledger.writeback] config as sheprd) ----------------


def writeback_config():
    path = os.path.expanduser("~/.config/herdr/config.toml")
    if not os.path.exists(path):
        return None
    import tomllib

    with open(path, "rb") as f:
        config = tomllib.load(f)
    return config.get("ledger", {}).get("writeback")


def writeback(card):
    """Set the task file's status and add decisions + summary under ## Decisions."""
    try:
        config = writeback_config()
    except Exception as err:  # a broken config must not lose the done
        return {"ok": False, "message": f"config unreadable: {err}"}
    if not config or not config.get("markdown_path"):
        return None
    prefix = card["id"].split("-", 1)[0]
    project = (config.get("projects") or {}).get(prefix)
    if not project:
        return {"ok": False, "message": f"no project for prefix {prefix}"}
    path = config["markdown_path"].format(root=config.get("root", ""), project=project, id=card["id"])
    if not os.path.exists(path):
        return {"ok": False, "message": f"file missing: {path}"}
    with open(path, encoding="utf-8", newline="") as f:
        original = f.read()
    # Edit as LF without a BOM, then put the file's own line endings and BOM back.
    bom = "\ufeff" if original.startswith("\ufeff") else ""
    newline = "\r\n" if "\r\n" in original else "\n"
    text = original[len(bom):].replace("\r\n", "\n")
    new = set_status(text, config.get("done_status", "done"))
    entries = [d["text"] for d in card.get("decisions", [])]
    if card.get("summary"):
        entries.append(f"Done {card['done_at'][:10]}: {card['summary']}")
    new = add_decisions(new, entries)
    name = os.path.basename(path)
    if new == text:
        return {"ok": True, "message": f"{name} already up to date"}
    new = bom + new.replace("\n", newline)
    directory = os.path.dirname(path)
    fd, temp = tempfile.mkstemp(prefix=f".{name}.cards-", dir=directory)
    with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
        f.write(new)
    os.chmod(temp, os.stat(path).st_mode & 0o7777)
    os.replace(temp, path)
    return {"ok": True, "message": f"wrote {name}"}


def set_status(text, status):
    """The front matter's status, set or added; a file without front matter is left alone."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return text
    close = next((i for i in range(1, len(lines)) if lines[i].strip() == "---"), None)
    if close is None:
        return text
    for i in range(1, close):
        if re.match(r"status\s*:", lines[i]):
            lines[i] = f"status: {status}"
            return "\n".join(lines)
    return "\n".join(lines[:close] + [f"status: {status}"] + lines[close:])


def outside_fences(lines):
    """For each line, whether it is outside a ``` or ~~~ code block."""
    out, fence = [], None
    for line in lines:
        mark = re.match(r"\s*(```|~~~)", line)
        if fence is None:
            out.append(not mark)
            if mark:
                fence = mark.group(1)
        else:
            out.append(False)
            if mark and mark.group(1) == fence:
                fence = None
    return out


def add_decisions(text, entries):
    lines = text.split("\n")
    real = outside_fences(lines)
    start = next((i for i, l in enumerate(lines) if real[i] and re.fullmatch(r"##\s+Decisions\s*", l.strip())), None)
    if start is None:
        new = [f"- {e}" for e in entries]
        if not new:
            return text
        body = text.rstrip("\n")
        return body + "\n\n## Decisions\n\n" + "\n".join(new) + "\n"
    end = next((i for i in range(start + 1, len(lines)) if real[i] and re.match(r"#{1,2}\s", lines[i])), len(lines))
    section = lines[start + 1 : end]
    existing = {l.strip()[2:].strip() for l in section if l.strip().startswith(("- ", "* "))}
    new = [f"- {e}" for e in entries if e.strip() not in existing]
    if not new:
        return text
    insert = end
    while insert > start + 1 and not lines[insert - 1].strip():
        insert -= 1
    return "\n".join(lines[:insert] + new + lines[insert:])


# ---- CLI --------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(prog="cards", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    def agent(name, **kw):
        p = sub.add_parser(name, **kw)
        p.add_argument("--terminal", help="default: $HC_TERMINAL_ID")
        return p

    p = agent("update", help="set a card's title, status, summary or link")
    p.add_argument("id")
    for field in ("title", "status", "summary", "link"):
        p.add_argument(f"--{field}")
    p.add_argument("--inferred", action="store_true",
                   help="written by a hook: fills only what no explicit write has set (never wins over one)")
    p.add_argument("--inferred-question", action="append", help="with --inferred: an open question (repeat)")
    p.add_argument("--clear-questions", action="store_true", help="with --inferred: drop earlier inferred questions")
    p.set_defaults(func=cmd_update)

    p = agent("ask", help="ask the user a question about a card")
    p.add_argument("id")
    p.add_argument("question")
    p.add_argument("--option", action="append", help="a suggested answer (repeat)")
    p.add_argument("--recommend", type=int, help="the recommended option, from 1")
    p.set_defaults(func=cmd_ask)

    p = agent("answered", help="close a question the user answered in the chat")
    p.add_argument("id")
    p.add_argument("--question", type=int, help="the question number")
    p.add_argument("--all", action="store_true", help="every open question of the card")
    p.add_argument("--answer", help="what the user answered (optional)")
    p.set_defaults(func=cmd_answered)

    p = agent("replied", help="mark open questions the user replied to in the chat (for hooks)")
    p.add_argument("items", nargs="+", help="CARD:N, e.g. SHE-12:1")
    p.set_defaults(func=cmd_replied)

    p = agent("decide", help="record a decision")
    p.add_argument("id")
    p.add_argument("decision")
    p.set_defaults(func=cmd_decide)

    p = agent("done", help="finish a card (and write it back to its task file)")
    p.add_argument("id")
    p.add_argument("--summary")
    p.set_defaults(func=cmd_done)

    p = agent("doc", help="show a document you wrote beside your pane, in the app")
    p.add_argument("path")
    p.add_argument("--line", type=int, help="scroll to this line")
    p.set_defaults(func=cmd_doc)

    p = agent("answers", help="answers the user sent you")
    p.add_argument("--peek", action="store_true", help="don't mark them read")
    p.set_defaults(func=cmd_answers)

    p = agent("list", help="your cards")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = agent("evidence", help="attach what you verified to a card: a screenshot, a test run or a link")
    p.add_argument("id")
    p.add_argument("--image", help="a png, jpeg, gif or webp file (max 2 MB)")
    p.add_argument("--test", help='a test run ending in passed/failed, e.g. "unit: 37/0"')
    p.add_argument("--link", help="an http(s) URL")
    p.add_argument("--label", help="a short name for the image or link")
    p.add_argument("--clear", action="store_true", help="remove all of the card's evidence")
    p.set_defaults(func=cmd_evidence)

    p = agent("evidence-image", help="an evidence image as base64 (for apps)")
    p.add_argument("id")
    p.add_argument("n", type=int, help="its number on the card, from 1")
    p.set_defaults(func=cmd_evidence_image)

    p = sub.add_parser("json", help="the whole document (for apps)")
    p.set_defaults(func=cmd_json)

    p = sub.add_parser("stage", help="stage an answer (for apps)")
    p.add_argument("terminal")
    p.add_argument("id")
    p.add_argument("n", type=int)
    p.add_argument("answer")
    p.set_defaults(func=cmd_stage)

    p = sub.add_parser("dismiss", help="dismiss a card or one question (for apps)")
    p.add_argument("terminal")
    p.add_argument("id")
    p.add_argument("--question", type=int)
    p.set_defaults(func=cmd_dismiss)

    p = sub.add_parser("reopen", help="put a question marked as replied back to open (for apps)")
    p.add_argument("terminal")
    p.add_argument("id")
    p.add_argument("--question", type=int, required=True)
    p.set_defaults(func=cmd_reopen)

    p = sub.add_parser("send", help="send a terminal's staged answers (for apps)")
    p.add_argument("terminal")
    p.set_defaults(func=cmd_send)

    p = sub.add_parser("view", help="the sidebar layout (for apps)")
    p.set_defaults(func=cmd_view)

    p = sub.add_parser("view-set", help="merge keys into the sidebar layout (for apps)")
    p.add_argument("patch")
    p.set_defaults(func=cmd_view_set)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
