#!/usr/bin/env bash
# Install/update sheprd (client-side herdr fork) from GitHub releases.
# Usage: sheprd-install [tag]   (default: latest sheprd-v* release)
# Installs ~/.local/share/sheprd/sheprd and a ~/.local/bin/sheprd symlink.
# Leaves any existing herdr install untouched.
# Builds: Linux x86_64 / aarch64 (static), macOS Apple Silicon / Intel.
set -euo pipefail
repo=andreconde21/sheprd

case "$(uname -s)" in
  Linux) os=linux ;;
  Darwin) os=macos ;;
  *) echo "sheprd has no build for $(uname -s) yet (Linux and macOS only)" >&2; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) arch=x86_64 ;;
  aarch64 | arm64) arch=aarch64 ;;
  *) echo "sheprd has no build for $(uname -m) yet (x86_64 and arm64 only)" >&2; exit 1 ;;
esac
asset="sheprd-$os-$arch"

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | awk '{print $1}'
}

# /releases/latest is the newest published release (the plain list is not date-ordered).
tag=${1:-$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" | grep -o '"tag_name": *"sheprd-v[^"]*"' | head -1 | sed 's/.*"\(sheprd-v[^"]*\)"/\1/')}
[ -n "$tag" ] || { echo "no sheprd-v* release found" >&2; exit 1; }
dir="$HOME/.local/share/sheprd"
mkdir -p "$dir" "$HOME/.local/bin"
base="https://github.com/$repo/releases/download/$tag"
curl -fsSL "$base/$asset" -o "$dir/sheprd.new" || {
  echo "release $tag has no $asset build" >&2; rm -f "$dir/sheprd.new"; exit 1
}
expected=$(curl -fsSL "$base/$asset.sha256" | awk '{print $1}')
actual=$(sha256 "$dir/sheprd.new")
[ "$expected" = "$actual" ] || { echo "checksum mismatch" >&2; rm -f "$dir/sheprd.new"; exit 1; }
chmod +x "$dir/sheprd.new" && mv "$dir/sheprd.new" "$dir/sheprd"
ln -sfn "$dir/sheprd" "$HOME/.local/bin/sheprd"
echo "$tag" > "$dir/VERSION"
echo "installed sheprd $tag ($asset) -> $dir/sheprd"
