#!/usr/bin/env python3
"""sheprd-claude-hook — tells sheprd what a Claude Code agent is up to.

Runs after each agent turn (Stop) and after to-do tool calls (PostToolUse), reads
the new part of the session transcript, and reports to herdr as pane metadata
tokens (the sheprd token format, see the sheprd README), which sheprd shows in its sidebar. herdr caps a value at 80
characters and a report at 16 tokens, hence many short tokens sent in batches.

  sheprd_ctx            current context size in tokens
  sheprd_session        Claude session id
  sheprd_u_YYYYMMDD     "input,output,cache_read,cache_write,active_minutes" per day (last 7)
  sheprd_todo           "done/total" of the agent's to-do list
  sheprd_todo_1..12     "✓ subject" / "▸ subject" (in progress) / "○ subject"
  sheprd_tl_1..10       timeline: "09:12 fix the bar widget (+3 edits, 2 cmds)", oldest first
  sheprd_refs           references mentioned in the chat (patterns from sheprd-refs.toml), newest first
  sheprd_w_1..10        work panel: one task each, "id|label|stage:s,stage:s" (s = r running, d done,
                        s stopped without a final answer), from the subagents this session started;
                        newest first; id is empty when the task names no reference
  sheprd_wf             path of the details file for the work panel (reports, visited pages)
  sheprd_q_1..3         open questions in the agent's last message, when it stopped (for the board)
  sheprd_sum            one-line summary of where the work stands (opt-in model summary)
  sheprd_sum_1..3       what got done recently, one line each (opt-in model summary)
  sheprd_sum_at         when that summary was made (HH:MM)

Model summaries run Claude Haiku through your Claude subscription (`claude -p --safe-mode`), in
the background. sheprd asks for one when its work panel shows the agent and the agent moved on
(`--summarize-session`); with `summaries = true` in ~/.config/herdr/sheprd-hook.toml every agent
also gets one when it stops or every 10 minutes while it works. Only when the transcript grew.

Incremental: a per-session cache keeps the read offset and state, so a turn only
costs the new lines. Never fails the agent: any error exits 0.

Install: `sheprd setup` (or `sheprd-claude-hook --install`) registers it in ~/.claude/settings.json
for Stop and for to-do tool calls.
"""
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timedelta

CACHE_DIR = os.path.expanduser("~/.cache/sheprd/claude-hook")
WORK_DIR = os.path.expanduser("~/.cache/sheprd/work")
MAX_WORK = 10
WORK_SCAN = 80  # most recent subagents looked at per turn
STAGE_ORDER = ["dev", "adversarial", "chrome"]  # pipeline order; other subagent types follow
HOOK_CONFIG = os.path.expanduser("~/.config/herdr/sheprd-hook.toml")
SUMMARY_EVERY = 600  # seconds between summaries while the agent keeps working
SUMMARY_MIN_GROWTH = 4000  # transcript bytes added before a new summary is worth it
SUMMARY_PROMPT = """You summarise a coding agent's session for the person running many agents at once.
Reply with ONE JSON object and nothing else:
{"title": "...", "done": ["...", "..."], "questions": ["..."]}
- title: where the work stands now, at most 10 words (the state of the work, not the step this minute).
- done: up to 3 short lines, what got done recently, newest last.
- questions: what the agent is waiting on the user for, as short questions; [] when nothing.
Plain words, no markdown."""
CONFIG = os.path.expanduser("~/.config/herdr/sheprd-refs.toml")
KEEP_DAYS = 7
MAX_TODOS = 12
MAX_TIMELINE = 10
MAX_VALUE = 80
EDIT_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}
COMMAND_TOOLS = {"Bash"}


def fit(text, limit=MAX_VALUE):
    text = " ".join(str(text).split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


def local_time(timestamp):
    return datetime.fromisoformat(timestamp.replace("Z", "+00:00")).astimezone()


class RefSource:
    """A pattern for reference ids (tasks, issues…), optionally limited to ids that exist as files
    (`ids_from`: a folder whose `<ID>.md` files are the tasks). With `ids_from`
    a generic pattern stays precise and new prefixes need no config change."""

    def __init__(self, pattern, ids_from=None):
        self.pattern = re.compile(pattern)
        self.known = None
        if ids_from:
            self.known = set()
            root = os.path.expanduser(ids_from)
            for _, dirs, files in os.walk(root):
                dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"]
                self.known.update(name[:-3] for name in files if name.endswith(".md"))

    def findall(self, text):
        found = [m if isinstance(m, str) else m[0] for m in self.pattern.findall(text or "")]
        return [task for task in found if self.known is None or task in self.known]


def task_patterns():
    """Reference sources from ~/.config/herdr/sheprd-refs.toml ([[refs]] pattern, ids_from)."""
    try:
        import tomllib
        with open(CONFIG, "rb") as handle:
            config = tomllib.load(handle)
    except (OSError, ImportError, ValueError):
        return []
    sources = []
    for source in config.get("refs", []):
        try:
            sources.append(RefSource(source["pattern"], source.get("ids_from")))
        except (KeyError, re.error):
            continue
    return sources


def fresh_cache():
    return {
        "offset": 0, "last_id": None, "ctx": 0, "days": {},
        "todos": [], "pending_creates": {}, "timeline": [], "tasks": [], "sent": [],
    }


def user_prompt_text(entry):
    """The human's prompt text, or None for tool results, meta and command noise."""
    if entry.get("type") != "user" or entry.get("isMeta"):
        return None
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, list):
        if any(part.get("type") == "tool_result" for part in content if isinstance(part, dict)):
            return None
        content = " ".join(
            part.get("text", "") for part in content
            if isinstance(part, dict) and part.get("type") == "text"
        )
    if not isinstance(content, str):
        return None
    text = content.strip()
    if not text or text.startswith("<") or text.startswith("Caveat:"):
        return None
    return text


def note_tasks(cache, text, patterns):
    for source in patterns:
        for task in source.findall(text):
            if task in cache["tasks"]:
                cache["tasks"].remove(task)
            cache["tasks"].insert(0, task)
    del cache["tasks"][20:]


def apply_tool_use(cache, use):
    name, data = use.get("name"), use.get("input") or {}
    timeline = cache["timeline"]
    if name in EDIT_TOOLS and timeline:
        timeline[-1]["edits"] += 1
    elif name in COMMAND_TOOLS and timeline:
        timeline[-1]["cmds"] += 1
    elif name == "TaskCreate":
        cache["pending_creates"][use.get("id", "")] = data.get("subject") or data.get("activeForm") or "task"
    elif name == "TaskUpdate":
        for todo in cache["todos"]:
            if todo["id"] == str(data.get("taskId")):
                if data.get("status"):
                    todo["status"] = data["status"]
                if data.get("subject"):
                    todo["subject"] = data["subject"]
        cache["todos"] = [t for t in cache["todos"] if t["status"] != "deleted"]
    elif name == "TodoWrite":
        cache["todos"] = [
            {"id": str(i + 1), "subject": t.get("content") or t.get("activeForm") or "task",
             "status": t.get("status", "pending")}
            for i, t in enumerate(data.get("todos") or [])
        ]


def apply_tool_result(cache, result):
    subject = cache["pending_creates"].pop(result.get("tool_use_id", ""), None)
    if subject is None:
        return
    content = result.get("content")
    text = content if isinstance(content, str) else json.dumps(content)
    match = re.search(r"#(\d+)", text or "")
    task_id = match.group(1) if match else str(len(cache["todos"]) + 1)
    cache["todos"].append({"id": task_id, "subject": subject, "status": "pending"})


def read_new_lines(cache, transcript, patterns):
    with open(transcript, "rb") as handle:
        handle.seek(cache["offset"])
        for raw in handle:
            if not raw.endswith(b"\n"):
                break  # partial line still being written; read it next time
            cache["offset"] += len(raw)
            try:
                entry = json.loads(raw)
            except ValueError:
                continue
            message = entry.get("message") or {}
            content = message.get("content")

            prompt = user_prompt_text(entry)
            if prompt and entry.get("timestamp"):
                cache["timeline"].append({
                    "time": local_time(entry["timestamp"]).strftime("%H:%M"),
                    "text": prompt, "edits": 0, "cmds": 0,
                })
                del cache["timeline"][:-50]
                note_tasks(cache, prompt, patterns)

            if isinstance(content, list):
                for part in content:
                    if not isinstance(part, dict):
                        continue
                    if part.get("type") == "tool_use":
                        apply_tool_use(cache, part)
                    elif part.get("type") == "tool_result":
                        apply_tool_result(cache, part)
                    elif part.get("type") == "text" and entry.get("type") == "assistant":
                        note_tasks(cache, part.get("text"), patterns)

            usage = message.get("usage")
            if entry.get("type") != "assistant" or not usage or not entry.get("timestamp"):
                continue
            # A streamed reply repeats the same message id on several lines.
            if message.get("id") and message.get("id") == cache["last_id"]:
                continue
            cache["last_id"] = message.get("id")
            when = local_time(entry["timestamp"])
            totals = cache["days"].setdefault(when.strftime("%Y-%m-%d"), [0, 0, 0, 0, []])
            totals[0] += usage.get("input_tokens", 0)
            totals[1] += usage.get("output_tokens", 0)
            totals[2] += usage.get("cache_read_input_tokens", 0)
            totals[3] += usage.get("cache_creation_input_tokens", 0)
            minute = when.strftime("%H:%M")
            if minute not in totals[4]:
                totals[4].append(minute)
            cache["ctx"] = (
                usage.get("input_tokens", 0)
                + usage.get("cache_read_input_tokens", 0)
                + usage.get("cache_creation_input_tokens", 0)
            )


def _last_entry(path):
    """The last JSON line of a (possibly large) transcript, read from the end."""
    try:
        with open(path, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            handle.seek(max(0, size - 65536))
            lines = handle.read().splitlines()
        for line in reversed(lines):
            if line.strip():
                return json.loads(line)
    except (OSError, ValueError):
        pass
    return None


def _final_text(entry):
    message = (entry or {}).get("message") or {}
    content = message.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text")
    return ""


def _visited(path, cache):
    """Pages a browser-driving subagent opened and files it saved (cached by size)."""
    key = f"{path}:{os.path.getsize(path)}"
    seen = cache.setdefault("visited", {})
    if key in seen:
        return seen[key]
    urls, files = [], []
    try:
        with open(path) as handle:
            for line in handle:
                if '"tool_use"' not in line:
                    continue
                for c in (json.loads(line).get("message") or {}).get("content") or []:
                    if not isinstance(c, dict) or c.get("type") != "tool_use":
                        continue
                    data = c.get("input") or {}
                    url = data.get("url")
                    if isinstance(url, str) and url.startswith(("http://", "https://")) and url not in urls:
                        urls.append(url)
                    for field in ("filename", "filePath", "path"):
                        value = data.get(field)
                        if isinstance(value, str) and value.lower().endswith((".png", ".gif", ".jpg", ".webm", ".mp4")):
                            files.append(value)
    except (OSError, ValueError):
        pass
    for old in [k for k in seen if k.startswith(f"{path}:")]:
        del seen[old]
    seen[key] = {"urls": urls[-8:], "files": files[-8:]}
    return seen[key]


def work(transcript, session, patterns, cache):
    """Tasks this session handed to subagents, grouped by reference id, with each stage's state."""
    folder = os.path.join(os.path.splitext(transcript)[0], "subagents")
    try:
        metas = sorted(
            (os.path.join(folder, name) for name in os.listdir(folder) if name.endswith(".meta.json")),
            key=os.path.getmtime, reverse=True,
        )[:WORK_SCAN]
    except OSError:
        return {}, None
    tasks = {}
    for meta_path in metas:
        try:
            with open(meta_path) as handle:
                meta = json.load(handle)
        except (OSError, ValueError):
            continue
        log = meta_path[: -len(".meta.json")] + ".jsonl"
        if not os.path.exists(log):
            continue
        description = (meta.get("description") or "").strip()
        stage = (meta.get("customAgentType") or "").strip()
        if not stage:
            stage = "general" if meta.get("agentType") == "general-purpose" else "agent"
        last = _last_entry(log)
        final = (last or {}).get("type") == "assistant" and ((last.get("message") or {}).get("stop_reason") == "end_turn")
        text = _final_text(last) if final else ""
        state = "d" if final else ("r" if os.path.getmtime(log) > datetime.now().timestamp() - 1800 else "s")
        ids = [task for source in patterns for task in source.findall(description)]
        key = ids[0] if ids else ""
        label = description
        for task in ids[:1]:
            label = re.sub(rf"\b{re.escape(task)}\b[:\s-]*", "", label).strip() or description
        entry = tasks.setdefault(key or description, {"key": key, "label": label, "stages": [], "at": os.path.getmtime(log)})
        if any(s["type"] == stage for s in entry["stages"]):
            continue  # newest run of this stage wins (metas are newest first)
        detail = {
            "type": stage, "state": state, "description": description,
            "verdict": fit(next((l.strip(" #*") for l in text.splitlines() if l.strip()), ""), 120),
            "report": text[:6000],
        }
        if any(word in stage.lower() for word in ("chrome", "browser")):
            detail.update(_visited(log, cache))
        entry["stages"].append(detail)
    ordered = sorted(tasks.values(), key=lambda t: t["at"], reverse=True)[:MAX_WORK]
    out = {}
    for i, task in enumerate(ordered, 1):
        task["stages"].sort(key=lambda s: STAGE_ORDER.index(s["type"]) if s["type"] in STAGE_ORDER else len(STAGE_ORDER))
        stages = ",".join(f"{s['type'][:12]}:{s['state']}" for s in task["stages"][-4:])
        head = f"{task['key']}|"
        out[f"sheprd_w_{i}"] = head + fit(task["label"], max(4, MAX_VALUE - len(head) - len(stages) - 1)) + "|" + stages
    if not ordered:
        return {}, None
    os.makedirs(WORK_DIR, exist_ok=True)
    path = os.path.join(WORK_DIR, f"{session}.json")
    with open(path + ".tmp", "w") as handle:
        json.dump({"tasks": ordered}, handle)
    os.replace(path + ".tmp", path)
    short = path.replace(os.path.expanduser("~"), "~", 1)
    out["sheprd_wf"] = short if len(short) <= MAX_VALUE else path[-MAX_VALUE:]
    return out, path


def last_assistant_text(transcript):
    """The text of the main agent's last message (read from the end of the transcript)."""
    try:
        with open(transcript, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - 262144))
            lines = handle.read().splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if entry.get("type") == "assistant" and not entry.get("isSidechain"):
            text = _final_text(entry)
            if text.strip():
                return text
    return ""


def open_questions(text):
    """Questions the agent asks the user in its last message: lines ending with '?'."""
    found = []
    for line in text.splitlines():
        line = re.sub(r"^\s*(?:[-*+]|\d+[.)])\s+", "", line).strip().strip("*_ ")
        if line.endswith("?") and len(line) > 3 and line not in found:
            found.append(fit(line))
    return found[:3]


def hook_config():
    try:
        import tomllib
        with open(HOOK_CONFIG, "rb") as handle:
            return tomllib.load(handle)
    except (OSError, ImportError, ValueError):
        return {}


def summary_path(session):
    return os.path.join(CACHE_DIR, f"{session}.summary.json")


def summary_tokens(session):
    try:
        with open(summary_path(session)) as handle:
            return json.load(handle).get("tokens", {})
    except (OSError, ValueError):
        return {}


def maybe_summarize(cache, session, transcript, pane, event):
    """Starts a background model summary when enabled and the session moved on enough."""
    if not hook_config().get("summaries"):
        return
    size = os.path.getsize(transcript)
    now = datetime.now().timestamp()
    last = cache.get("summary", {"size": 0, "at": 0})
    grew = size - last.get("size", 0) >= SUMMARY_MIN_GROWTH
    due = event == "Stop" or now - last.get("at", 0) >= SUMMARY_EVERY
    if not (grew and due):
        return
    cache["summary"] = {"size": size, "at": now}
    env = {k: v for k, v in os.environ.items() if k != "HERDR_PANE_ID"}
    env["SHEPRD_HOOK_SKIP"] = "1"
    subprocess.Popen(
        [sys.executable, os.path.realpath(__file__), "--summarize", session, transcript, pane],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True, env=env,
    )


def digest(transcript, limit=12000):
    """First prompt plus the newest messages, as short 'USER:' / 'AGENT:' lines."""
    lines = []
    try:
        with open(transcript) as handle:
            for raw in handle:
                try:
                    entry = json.loads(raw)
                except ValueError:
                    continue
                if entry.get("isSidechain"):
                    continue
                kind = entry.get("type")
                if kind == "user":
                    text = user_prompt_text(entry)
                    if text:
                        lines.append("USER: " + text[:600])
                elif kind == "assistant":
                    text = _final_text(entry).strip()
                    if text:
                        lines.append("AGENT: " + text[:300].replace("\n", " "))
    except OSError:
        return ""
    if not lines:
        return ""
    first, rest = lines[0], lines[1:]
    kept, size = [], len(first)
    for line in reversed(rest):
        if size + len(line) > limit:
            break
        kept.append(line)
        size += len(line)
    skipped = len(rest) - len(kept)
    return "\n".join([first] + ([f"... {skipped} earlier messages ..."] if skipped else []) + list(reversed(kept)))


def summarize_session(session, pane):
    """On request (sheprd's work panel): summarize a session found by id, if it moved on."""
    import glob
    found = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{session}.jsonl"))
    if not found:
        return
    transcript = found[0]
    try:
        with open(summary_path(session)) as handle:
            done_size = json.load(handle).get("size", 0)
    except (OSError, ValueError):
        done_size = 0
    if os.path.getsize(transcript) - done_size < 2000:
        return
    summarize(session, transcript, pane)


def summarize(session, transcript, pane):
    """Background: ask Haiku for a summary and report it (sheprd_sum, sheprd_sum_1..3)."""
    size = os.path.getsize(transcript)
    text = digest(transcript)
    if not text:
        return
    claude = os.environ.get("SHEPRD_CLAUDE_BIN") or "claude"
    result = subprocess.run(
        [claude, "-p", "--safe-mode", "--no-session-persistence", "--tools", "", "--model", "haiku",
         "--output-format", "text", "--append-system-prompt", SUMMARY_PROMPT],
        input=text, capture_output=True, text=True, timeout=120, check=False,
    )
    match = re.search(r"\{.*\}", result.stdout or "", re.S)
    if not match:
        return
    data = json.loads(match.group(0))
    out = {}
    if data.get("title"):
        out["sheprd_sum"] = fit(str(data["title"]))
    for i, line in enumerate([str(d) for d in data.get("done", [])][-3:], 1):
        out[f"sheprd_sum_{i}"] = fit(line)
    out["sheprd_sum_at"] = datetime.now().strftime("%H:%M")
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(summary_path(session) + ".tmp", "w") as handle:
        json.dump({"tokens": out, "size": size,
                   "questions": [fit(str(q)) for q in data.get("questions", [])][:3]}, handle)
    os.replace(summary_path(session) + ".tmp", summary_path(session))
    report(pane, out, [])


def report(pane, values, clear):
    operations = [["--token", f"{name}={value}"] for name, value in sorted(values.items())]
    operations += [["--clear-token", name] for name in clear]
    herdr = os.environ.get("HERDR_BIN_PATH") or "herdr"
    debug = bool(os.environ.get("SHEPRD_HOOK_DEBUG"))
    # herdr accepts at most 16 token updates per metadata report.
    for start in range(0, len(operations), 16):
        args = [arg for operation in operations[start:start + 16] for arg in operation]
        result = subprocess.run(
            [herdr, "pane", "report-metadata", pane, "--source", "sheprd", *args],
            capture_output=True, text=True, timeout=5, check=False,
        )
        if debug:
            print("herdr exit", result.returncode, result.stderr[-800:], file=sys.stderr)


def tokens(cache):
    out = {"sheprd_ctx": str(cache["ctx"])}
    for day, t in sorted(cache["days"].items()):
        out[f"sheprd_u_{day.replace('-', '')}"] = ",".join(str(v) for v in t[:4] + [len(t[4])])
    todos = cache["todos"]
    if todos:
        done = sum(1 for t in todos if t["status"] == "completed")
        out["sheprd_todo"] = f"{done}/{len(todos)}"
        marks = {"completed": "✓", "in_progress": "▸"}
        for i, todo in enumerate(todos[:MAX_TODOS], 1):
            out[f"sheprd_todo_{i}"] = fit(f"{marks.get(todo['status'], '○')} {todo['subject']}")
    for i, step in enumerate(cache["timeline"][-MAX_TIMELINE:], 1):
        extra = []
        if step["edits"]:
            extra.append(f"+{step['edits']} edit{'s' if step['edits'] != 1 else ''}")
        if step["cmds"]:
            extra.append(f"{step['cmds']} cmd{'s' if step['cmds'] != 1 else ''}")
        suffix = f" ({', '.join(extra)})" if extra else ""
        out[f"sheprd_tl_{i}"] = fit(f"{step['time']} {fit(step['text'], MAX_VALUE - 6 - len(suffix))}{suffix}")
    if cache["tasks"]:
        listed = []
        for task in cache["tasks"]:
            if len(",".join(listed + [task])) > MAX_VALUE:
                break
            listed.append(task)
        out["sheprd_refs"] = ",".join(listed)
    return out


def main():
    if os.environ.get("SHEPRD_HOOK_SKIP"):
        return
    hook = json.load(sys.stdin)
    pane = os.environ.get("HERDR_PANE_ID")
    transcript = hook.get("transcript_path")
    session = hook.get("session_id")
    if not (pane and transcript and session and os.path.exists(transcript)):
        return

    os.makedirs(CACHE_DIR, exist_ok=True)
    cache_path = os.path.join(CACHE_DIR, f"{session}.json")
    try:
        with open(cache_path) as handle:
            cache = {**fresh_cache(), **json.load(handle)}
    except (OSError, ValueError):
        cache = fresh_cache()
    if os.path.getsize(transcript) < cache["offset"]:
        cache = fresh_cache()

    read_new_lines(cache, transcript, task_patterns())
    oldest = (datetime.now() - timedelta(days=KEEP_DAYS - 1)).strftime("%Y-%m-%d")
    cache["days"] = {day: t for day, t in cache["days"].items() if day >= oldest}

    current = tokens(cache)
    current["sheprd_session"] = session
    work_tokens, _ = work(transcript, session, task_patterns(), cache)
    current.update(work_tokens)
    event = hook.get("hook_event_name", "")
    if event == "Stop":
        cache["questions"] = open_questions(last_assistant_text(transcript))
    elif event == "PostToolUse":
        cache["questions"] = []  # working again: not waiting on the user
    for i, question in enumerate(cache.get("questions", []), 1):
        current[f"sheprd_q_{i}"] = question
    current.update(summary_tokens(session))
    maybe_summarize(cache, session, transcript, pane, event)
    stale = [name for name in cache.get("sent", []) if name not in current]
    cache["sent"] = sorted(current)

    tmp = cache_path + ".tmp"
    with open(tmp, "w") as handle:
        json.dump(cache, handle)
    os.replace(tmp, cache_path)

    if os.environ.get("SHEPRD_HOOK_DRY"):
        print(json.dumps({"set": current, "clear": stale}, ensure_ascii=False, indent=1))
        return
    report(pane, current, stale)


def install():
    """Register this script for Stop and to-do tool calls, replacing older registrations."""
    path = os.path.expanduser("~/.claude/settings.json")
    try:
        with open(path) as handle:
            settings = json.load(handle)
    except (OSError, ValueError):
        settings = {}
    command = f"python3 {os.path.realpath(__file__)}"
    old = ("sheprd-claude-hook", "agent-insights", "sheprd-usage-hook")
    hooks = settings.setdefault("hooks", {})
    for event in ("Stop", "PostToolUse", "SubagentStop"):
        groups = []
        for group in hooks.get(event, []):
            group["hooks"] = [h for h in group.get("hooks", []) if not any(o in h.get("command", "") for o in old)]
            if group["hooks"]:
                groups.append(group)
        hooks[event] = groups
    hooks["Stop"].append({"hooks": [{"type": "command", "command": command}]})
    hooks["PostToolUse"].append({"matcher": "TaskCreate|TaskUpdate|TodoWrite|Agent|Task",
                                 "hooks": [{"type": "command", "command": command}]})
    # The work panel: a subagent finished.
    hooks["SubagentStop"].append({"hooks": [{"type": "command", "command": command}]})
    if os.path.exists(path):
        with open(path) as src, open(path + ".bak-sheprd", "w") as dst:
            dst.write(src.read())
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as handle:
        json.dump(settings, handle, indent=2)
    print(f"registered {command} in {path}")


if __name__ == "__main__":
    if sys.argv[1:] == ["--install"]:
        install()
        sys.exit(0)
    if sys.argv[1:2] == ["--summarize-session"] and len(sys.argv) == 4:
        os.environ["SHEPRD_HOOK_SKIP"] = "1"  # the claude -p it starts must not run this hook
        try:
            summarize_session(*sys.argv[2:4])
        except Exception:  # noqa: BLE001 - background, never visible
            pass
        sys.exit(0)
    if sys.argv[1:2] == ["--summarize"] and len(sys.argv) == 5:
        try:
            summarize(*sys.argv[2:5])
        except Exception:  # noqa: BLE001 - background, never visible
            pass
        sys.exit(0)
    try:
        main()
    except Exception:  # noqa: BLE001 - an insights hook must never break the agent
        if os.environ.get("SHEPRD_HOOK_DEBUG"):
            import traceback
            traceback.print_exc()
    sys.exit(0)
